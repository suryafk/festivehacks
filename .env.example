# Copy to .env and fill in. Everything is optional: missing keys fall back to offline defaults so the demo still runs.

# Public HTTPS URL of the deployment (needed for WhatsApp voice replies + browser mic)
PUBLIC_BASE_URL=https://YOUR-VM-IP.sslip.io

# Sarvam AI: https://dashboard.sarvam.ai → API keys
SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=

# Flagsmith: app.flagsmith.com → your project → Environment settings → Server-side SDK key (ser.xxxx)
FLAGSMITH_ENVIRONMENT_KEY=
# Only for scripts/flagsmith-setup.mjs and the NudgeBee workflow (Organisation settings → API keys)
FLAGSMITH_ADMIN_API_KEY=
FLAGSMITH_PROJECT_ID=

# Twilio WhatsApp sandbox: console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN=join your-code

# Shared secrets (change these)
INTERNAL_TOKEN=change-me-internal
OPS_TOKEN=change-me-ops

# Google Flights live fares via SerpApi: https://serpapi.com/manage-api-key (free plan: 250 searches/month; results cached 6 h)
SERPAPI_KEY=
